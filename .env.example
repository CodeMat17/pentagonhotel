# The Convex deployment the dashboard writes to (pentagon-dashboard).
# Copy the value from that project's .env.local, or run `npx convex dev` there.
#
# Leave it unset and the site still builds and serves: every content read in
# lib/content.ts falls back to the bundled copy in lib/data.ts. Forms and
# bookings, which have nowhere to fall back to, tell the guest to call instead.
NEXT_PUBLIC_CONVEX_URL=

# Shared with the dashboard's Convex deployment (set REVALIDATE_SECRET and
# SITE_URL there too). Lets a dashboard save refresh the site's cached pages via
# /api/revalidate. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=
